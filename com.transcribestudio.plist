<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Background launchd agent that keeps Transcribe Studio's Flask backend
  running. WorkingDirectory is /tmp to avoid macOS TCC denying getcwd()
  for child processes (whisper-cli, ffmpeg) when CWD is in ~/Documents.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.transcribestudio</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_HOME/Documents/cowork-tools/transcribe-studio/run.sh</string>
    <string>--no-browser</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>WorkingDirectory</key>
  <string>/tmp</string>

  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/Documents/cowork-tools/transcribe-studio/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/Documents/cowork-tools/transcribe-studio/logs/launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
