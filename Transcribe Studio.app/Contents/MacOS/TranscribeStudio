#!/usr/bin/env bash
# TranscribeStudio — .app entry point.
# When you double-click "Transcribe Studio.app" macOS runs this binary.
# We make sure the backend is running, then open the browser.

set -uo pipefail
cd /tmp

STUDIO="$HOME/Documents/cowork-tools/transcribe-studio"
URL="http://127.0.0.1:5180"

# If the backend isn't already running, kick off run.sh in the background
if ! curl -sf "$URL/api/status" >/dev/null 2>&1; then
  nohup "$STUDIO/run.sh" --no-browser > "$STUDIO/logs/app-launch.log" 2>&1 &
  # Give it a couple seconds to start
  for _ in $(seq 1 20); do
    sleep 0.5
    if curl -sf "$URL/api/status" >/dev/null 2>&1; then break; fi
  done
fi

open "$URL"
